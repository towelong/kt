# SQLite（默认）
DATABASE_URL=sqlite:///./app.db

# MySQL：驱动固定 pymysql，charset 必须是 utf8mb4，密码按 urlencode 处理
# DATABASE_URL=mysql+pymysql://USER:<秘密>@127.0.0.1:3306/kt?charset=utf8mb4

APP_NAME=kt
DEBUG=false

# 开发环境打开：启动时自动 alembic upgrade head。
# 生产/多副本保持 false，迁移放到发布流程单独执行
AUTO_MIGRATE=true

# AiLink VCC 开放 API（不填就调不了；Secret 只放 .env，别进代码和日志）
AILINK_BASE_URL=https://card.ailinkvcc.com
AILINK_API_KEY=
AILINK_API_SECRET=
# Webhook 验签和卡三要素解密都用它，明文只在生成时展示一次
AILINK_WEBHOOK_SECRET=
AILINK_TIMEOUT_SECONDS=10
AILINK_WEBHOOK_MAX_BODY_BYTES=1048576
# 排查时临时打开：成功请求也打印 header/body（OTP、卡密文、session 会自动打码）
AILINK_WEBHOOK_DEBUG=false

# 卡库存扫描：先配好上面的 Key/Secret 再打开，否则任务只打 error 日志不启动
CARD_STOCK_ENABLED=true
CARD_STOCK_INTERVAL_SECONDS=300
CARD_STOCK_PENDING_MINUTES=30
CARD_STOCK_USDT_USD_RATE=0.997
OPEN_CARD_MAX_ATTEMPTS=5

# BYOC 订阅（Strong Exchange）。session 会加密落库，所以 TASK_PAYLOAD_KEY 必须配
BYOC_BASE_URL=https://wangbohui.com
BYOC_API_KEY=
BYOC_CALLBACK_SECRET=kN3ZZsedphLExCgX9i2V
TASK_PAYLOAD_KEY=ywA9DDrE22AHX5ijHoQm
SUBSCRIPTION_WORKER_ENABLED=true
SUBSCRIPTION_WORKER_INTERVAL_SECONDS=10
SUBSCRIPTION_CALLBACK_MAX_ATTEMPTS=5
SUBSCRIPTION_MAX_SUBMIT_ATTEMPTS=10
SUBSCRIPTION_RETRY_BACKOFF_SECONDS=60
SUBSCRIPTION_RETRY_MAX_BACKOFF_SECONDS=300

# 平台限流（次/分钟），每个真实 HTTP 请求占一个配额，重试也占
AILINK_RATE_LIMIT_PER_MINUTE=450
BYOC_RATE_LIMIT_PER_MINUTE=300
